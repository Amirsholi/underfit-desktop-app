<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="../../tablet-app/**/*" Link="wwwroot/tablet/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../logo.jpg" Link="wwwroot/tablet/assets/logo.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../gym.jpg" Link="wwwroot/tablet/assets/gym.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Plate Gt Two Four MT Std Bd.ttf" Link="wwwroot/tablet/assets/title.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../node_modules/@fortawesome/fontawesome-free/svgs/solid/calendar-days.svg;../../node_modules/@fortawesome/fontawesome-free/svgs/solid/dumbbell.svg;../../node_modules/@fortawesome/fontawesome-free/svgs/solid/person-running.svg;../../node_modules/@fortawesome/fontawesome-free/svgs/solid/file-lines.svg" Link="wwwroot/tablet/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UnderFit.Application/UnderFit.Application.csproj" />
    <ProjectReference Include="../UnderFit.Contracts/UnderFit.Contracts.csproj" />
    <ProjectReference Include="../UnderFit.Infrastructure/UnderFit.Infrastructure.csproj" />
  </ItemGroup>
</Project>
